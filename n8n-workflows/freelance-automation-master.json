      "parameters": {
        "functionCode": "// Парсинг ответа от AI\nconst aiResponse = $input.item.json.choices[0].message.content;\n\n// Извлекаем JSON из ответа (может быть обёрнут в markdown)\nlet analysis;\ntry {\n  const jsonMatch = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  analysis = JSON.parse(jsonMatch[0]);\n} catch (error) {\n  return {\n    json: {\n      error: true,\n      errorMessage: 'Ошибка парсинга ответа AI: ' + error.message,\n      rawResponse: aiResponse\n    }\n  };\n}\n\n// Объединяем данные\nreturn {\n  json: {\n    ...($node[\"Parse Message\"].json),\n    analysis: analysis,\n    analysisCompleted: true\n  }\n};"
      },
