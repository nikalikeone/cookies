      "parameters": {
        "functionCode": "// Парсинг оценки\nconst reviewResponse = $input.item.json.choices[0].message.content;\n\nlet review;\ntry {\n  const jsonMatch = reviewResponse.match(/\\{[\\s\\S]*\\}/);\n  review = JSON.parse(jsonMatch[0]);\n} catch (error) {\n  // Если не удалось распарсить, считаем что отклик хороший\n  review = {\n    overallScore: 8,\n    improve: false,\n    suggestions: ''\n  };\n}\n\nconst currentIteration = $node[\"Extract Draft\"].json.iteration || 0;\n\nreturn {\n  json: {\n    ...($node[\"Extract Draft\"].json),\n    review: review,\n    iteration: currentIteration + 1,\n    needsImprovement: review.improve && review.overallScore < 8 && currentIteration < 2,\n    suggestions: review.suggestions || ''\n  }\n};"
      },
