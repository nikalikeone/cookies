    {
      "parameters": {
        "functionCode": "// Парсинг входящего сообщения от пользователя\nconst message = $input.item.json.message.text;\n\n// Регулярные выражения для парсинга структурированного сообщения\nconst patterns = {\n  title: /Заголовок:\\s*(.+)/i,\n  platform: /Биржа:\\s*(.+)/i,\n  link: /Ссылка:\\s*(.+)/i,\n  description: /Описание:\\s*([\\s\\S]*?)(?=Бюджет:|Дедлайн:|$)/i,\n  budget: /Бюджет:\\s*(.+)/i,\n  deadline: /Дедлайн:\\s*(.+)/i\n};\n\n// Извлечение данных\nconst data = {\n  title: message.match(patterns.title)?.[1]?.trim() || '',\n  platform: message.match(patterns.platform)?.[1]?.trim() || 'Unknown',\n  link: message.match(patterns.link)?.[1]?.trim() || '',\n  description: message.match(patterns.description)?.[1]?.trim() || message,\n  budget: message.match(patterns.budget)?.[1]?.trim() || 'Не указан',\n  deadline: message.match(patterns.deadline)?.[1]?.trim() || 'Не указан',\n  rawMessage: message,\n  chatId: $input.item.json.message.chat.id,\n  messageId: $input.item.json.message.message_id,\n  timestamp: new Date().toISOString()\n};\n\n// Валидация: проверяем, что хотя бы описание есть\nif (!data.description || data.description.length < 10) {\n  return {\n    json: {\n      error: true,\n      errorMessage: 'Описание задания слишком короткое. Минимум 10 символов.',\n      chatId: data.chatId\n    }\n  };\n}\n\nreturn {\n  json: data\n};"
      },
