# ============================================
# FREELANCE AUTOMATION BOT — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ============================================
# Скопируйте этот файл как .env и заполните значения
# cp .env.example .env
# ============================================

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here
N8N_ENCRYPTION_KEY=your_random_encryption_key_here
N8N_PORT=5678

# Webhook URL (обязательно для Telegram)
# Для локальной разработки используйте ngrok: https://xxxx.ngrok.io
# Для продакшена — ваш домен: https://n8n.yourdomain.com
WEBHOOK_URL=https://your-domain.com/

# --- Telegram Bot ---
# Получите токен у @BotFather в Telegram
# Формат: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- OpenRouter (основной AI-провайдер, бесплатные модели) ---
# Зарегистрируйтесь на https://openrouter.ai
# Создайте ключ: Keys → Create Key
# Формат: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# --- Альтернативные AI-провайдеры (опционально) ---

# Google Gemini (бесплатно, 1500 запросов/день)
# Получите ключ: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# Groq (бесплатно, Llama 3.3 70B, 14400 запросов/день)
# Получите ключ: https://console.groq.com
GROQ_API_KEY=

# Mistral AI (бесплатно, Mistral Small)
# Получите ключ: https://console.mistral.ai
MISTRAL_API_KEY=

# --- Модели (можно менять) ---
# Бесплатные модели на OpenRouter:
MODEL_ANALYSIS=google/gemini-2.0-flash-exp:free
MODEL_RESPONSE=mistralai/mistral-small-3.1-24b-instruct:free
MODEL_REVIEW=meta-llama/llama-4-maverick:free
MODEL_CODE=google/gemini-2.0-flash-exp:free
MODEL_DESIGN=google/gemini-2.0-flash-exp:free

# --- Настройки workflow ---
# Максимум итераций self-correction loop
MAX_RESPONSE_ITERATIONS=3
MAX_CODE_ITERATIONS=3

# Минимальная оценка для принятия отклика (1-10)
MIN_RESPONSE_SCORE=8
